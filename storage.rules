rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Path structure: users/{userId}/tracks/{trackId}/{filename}
    match /users/{userId}/tracks/{trackId}/{fileName} {
      
      // Helper function to check if the user is authenticated and owns the path
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      
      // Helper function to check for valid audio MIME types
      function isValidAudio() {
        return request.resource.contentType.matches('audio/mpeg|audio/wav|audio/x-wav|audio/ogg|audio/flac|audio/aac|audio/mp4|audio/x-m4a');
      }
      
      // Helper function to check if file size is within limits (100MB)
      function isReasonableSize() {
        return request.resource.size <= 100 * 1024 * 1024; // 100 Megabytes
      }

      // Read: Users can only read their own files
      allow read: if isOwner();
      
      // Create: Users can only upload valid, sized audio files to their own directory
      allow create: if isOwner() && isValidAudio() && isReasonableSize();
      
      // Update: Users can update their files (e.g. metadata) if they stay within constraints
      allow update: if isOwner() && isValidAudio() && isReasonableSize();
      
      // Delete: Users can delete their own files
      allow delete: if isOwner();
    }

    // Path structure: users/{userId}/covers/{projectId}/{fileName}
    match /users/{userId}/covers/{projectId}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function isValidImage() {
        return request.resource.contentType.matches('image/jpeg|image/png|image/webp');
      }
      function isReasonableImageSize() {
        return request.resource.size <= 10 * 1024 * 1024; // 10 Megabytes
      }

      allow read: if isOwner();
      allow create: if isOwner() && isValidImage() && isReasonableImageSize();
      allow update: if isOwner() && isValidImage() && isReasonableImageSize();
      allow delete: if isOwner();
    }
  }
}
